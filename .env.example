# ──────────────────────────────────────────────────────────────────────────────
# Environment variables for local development / docker-compose
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# Port exposures (optional — defaults shown)
API_PORT=8000
MLFLOW_PORT=5000

# Log level for the API container (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Pipeline config path inside the container (usually don't change)
PIPELINE_CONFIG=/app/configs/pipeline.yaml

# ── For CD deployment ─────────────────────────────────────────────────────────
# These are used by the CD workflow (.github/workflows/cd.yml) — set as
# GitHub Secrets, NOT here.

# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token

# DEPLOY_HOST=your.server.ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<private key content>
# DEPLOY_DIR=/opt/spam-phone
