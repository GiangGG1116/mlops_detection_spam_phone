# ----------------------------------------------------------------------
# Python & Virtual Environments
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------------------------
# Environment Variables
# ----------------------------------------------------------------------
.env
.env.*
!.env.example

# ----------------------------------------------------------------------
# Data & Runtime Artifacts
# ----------------------------------------------------------------------
# Ignore all files in data directories to prevent committing large datasets
data/*
# Keep the directory structure
!data/.gitkeep
!data/input/
!data/predictions/
!data/train/
!data/runs/

# Ignore contents of subdirectories but keep the directories themselves
data/input/*
!data/input/.gitkeep

data/predictions/*
!data/predictions/.gitkeep

data/train/*
!data/train/.gitkeep

data/runs/*
!data/runs/.gitkeep

# ----------------------------------------------------------------------
# Model Artifacts
# ----------------------------------------------------------------------
# Ignore all models to avoid bloating the repository
models/*
# Keep the directory structure
!models/.gitkeep
!models/archive/
!models/candidates/
!models/production/

models/archive/*
!models/archive/.gitkeep

models/candidates/*
!models/candidates/.gitkeep

models/production/*
!models/production/.gitkeep

# ----------------------------------------------------------------------
# MLflow & Experiment Tracking
# ----------------------------------------------------------------------
mlruns/
.mlruns/

# ----------------------------------------------------------------------
# Testing, Linting & Coverage
# ----------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ----------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------
*.log
logs/

# ----------------------------------------------------------------------
